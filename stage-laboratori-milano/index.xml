tString) return;&#13;&#10;&#13;&#10; const targetDate = new Date(targetString).getTime();&#13;&#10; const elDays = container.querySelector('.js-cd-days');&#13;&#10; const elHours = container.querySelector('.js-cd-hours');&#13;&#10; const elMins = container.querySelector('.js-cd-mins');&#13;&#10;&#13;&#10; function updateCountdown() {&#13;&#10; const now = new Date().getTime();&#13;&#10; const diff = targetDate - now;&#13;&#10;&#13;&#10; if (diff &lt;= 0) {&#13;&#10; container.innerHTML = '&lt;span class="gold f6 ttu b"&gt;Stage in corso o concluso!&lt;/span&gt;';&#13;&#10; return;&#13;&#10; }&#13;&#10;&#13;&#10; const days = Math.floor(diff / (1000 * 60 * 60 * 24));&#13;&#10; const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));&#13;&#10; const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));&#13;&#10;&#13;&#10; if (elDays) elDays.textContent = String(days).padStart(2, '0');&#13;&#10; if (elHours) elHours.textContent = String(hours).padStart(2, '0');&#13;&#10; if (elMins) elMins.textContent = String(minutes).padStart(2, '0');&#13;&#10; }&#13;&#10;&#13;&#10; updateCountdown();&#13;&#10; setInterval(updateCountdown, 60000); &#13;&#10;})();&#13;&#10;&lt;/script&gt;&#10;&lt;h3 id="orari-degli-stage"&gt;ORARI DEGLI STAGE&lt;/h3&gt;&#10;&lt;ul class="lista4"&gt;&#10;&lt;li&gt;Ore 14:00 BAMBINI&lt;/li&gt;&#10;&lt;li&gt;Ore 15:00 ADULTI&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;hr&gt;&#10;&lt;p&gt;MJ Experience è un percorso dedicato al mondo di Michael Jackson. Un&amp;rsquo;occasione per imparare e vivere da vicino lo stile, l&amp;rsquo;energia e i movimenti che hanno reso particolari le sue performance.&lt;/p&gt;</description></item><item><title>Quando il cante diventa baile - Carlos Guillén</title><link>https://www.ilmosaicodanza.it/stage-laboratori-milano/stage-flamenco-carlos-guillen-milano-maggio-2026/</link><pubDate>Sat, 02 May 2026 18:58:42 +0000</pubDate><guid>https://www.ilmosaicodanza.it/stage-laboratori-milano/stage-flamenco-carlos-guillen-milano-maggio-2026/</guid><description>Stage intensivo di flamenco a Milano con Carlos Guillén (cantaor, flamencologo). Dal 23 al 27 maggio 2026 nelle sedi Mosaico Danza. Approfondisci cante e baile!</description></item><item><title>LABORATORIO DI PIZZICA E TARANTELLE A MILANO | Il Mosaico Danza</title><link>https://www.ilmosaicodanza.it/stage-laboratori-milano/laboratorio-pizzica-tarantelle-milano/</link><pubDate>Wed, 11 Mar 2026 11:39:49 +0100</pubDate><guid>https://www.ilmosaicodanza.it/stage-laboratori-milano/laboratorio-pizzica-tarantelle-milano/</guid><description>Laboratorio serale di Pizzica e Tarantelle al Mosaico Danza con Gaia Ceccoli: un incontro aperto a tutti per esplorare i ritmi del Sud Italia, liberare il movimento e ritrovare energia e benessere nel Cerchio.</description></item><item><title>Laboratorio Teatrale: Potenzia la Tua Presenza per il Saggio</title><link>https://www.ilmosaicodanza.it/stage-laboratori-milano/laboratorio-teatro-saggio-2025/</link><pubDate>Mon, 12 May 2025 01:32:25 +0200</pubDate><guid>https://www.ilmosaicodanza.it/stage-laboratori-milano/laboratorio-teatro-saggio-2025/</guid><description>Potenzia la tua presenza scenica e scopri il teatro! Partecipa al laboratorio del Mosaico Danza in preparazione del saggio di fine anno Sabato 17 Maggio</description></item></channel></rss>